# Skopiuj do .env i uzupełnij. .env jest w .gitignore — nigdy go nie commituj.
# W GitHub Actions te same nazwy trafiają do repository secrets.

# --- Kalendarz wyników ---
# Finnhub: darmowy klucz z https://finnhub.io/dashboard
# Limit darmowego planu: 60 zapytań/min.
EMSCAN_FINNHUB_API_KEY=

# --- Łańcuch opcji i historia cen OHLC ---
# NIE WYMAGAJĄ KLUCZA. Łańcuch opcji wraz z ceną spot pochodzi z publicznego
# endpointu CBOE, a historia OHLC z Nasdaqa — patrz docs/PROBE-2026-08-17.md.
# Nie ma tu nic do uzupełnienia.

# Polygon.io: płatne, w pełni opcjonalne. Puste = źródło wyłączone.
EMSCAN_POLYGON_API_KEY=

# --- Faza 4 (LLM). Do fazy 3 włącznie nieużywane. ---
ANTHROPIC_API_KEY=

# --- Ustawienia runtime (opcjonalne, mają sensowne domyślne) ---
# EMSCAN_DB_PATH=data/emscan.db
# EMSCAN_RAW_DIR=data/raw
# EMSCAN_HTTP_TIMEOUT=20.0
# EMSCAN_USER_AGENT=emscan/0.1 (research tool)
